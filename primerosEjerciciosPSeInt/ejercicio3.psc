Algoritmo sin_titulo
	definir numero1,numero2,numero3,numero4 Como Real;
	Escribir "didite el valor del numero1";
	Leer numero1;
	Escribir "digite el valor del numero2";
	Leer numero2;
	Escribir "digite el valor del numero3";
	Leer numero3;
	Escribir "digite el valor del numero4";
	Leer numero4
	suma<-numero1+numero2+numero3+numero4;
	promedio<-suma/4;
	Escribir "la suma de los numeros es:",suma;
	Escribir "el promedio de los numeros es:",promedio;
FinAlgoritmo


